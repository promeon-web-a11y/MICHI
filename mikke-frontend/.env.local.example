# SupabaseプロジェクトのURLとanon key。
# どちらもフロントエンドに公開して問題ない値です（アクセス制御はRLSで行います）。
# Supabaseダッシュボード > Project Settings > API から取得できます。
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_anon_key

# お問い合わせ・アカウント削除依頼を受け付けるサポート用メールアドレス（画面に公開されます）。
# Vercel本番（VERCEL_ENV=production）では未設定だとビルドが失敗します。
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# 公開URL（任意）。独自ドメインへ移行するときに設定します。未設定なら src/lib/siteInfo.ts の既定値を使います。
NEXT_PUBLIC_SITE_URL=https://mikke-frontend.vercel.app

# ---- ここから下はサーバー専用（NEXT_PUBLIC_ を付けない。ブラウザには渡らない）----
# Home の AI 入力欄（/api/plan・/api/place-photo）が使います。
# mikke-supabase-backend の Edge Function Secrets と同じ名前・同じ値を設定してください。
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_PLAN_MODEL=replace_with_available_structured_output_model
GOOGLE_PLACES_API_KEY=replace_with_google_places_api_key
