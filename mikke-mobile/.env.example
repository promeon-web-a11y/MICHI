# .env.local にコピーして値を設定してください（.env*.local は Git 管理外）。
# EXPO_PUBLIC_* はアプリに埋め込まれ誰でも読める値です。公開して問題ない値だけを置きます。
# OpenAI / Google Places の API キーは絶対にここへ書かないでください（Supabase Secrets で管理）。
#
# mikke-frontend の NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY と同じ値です。
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key

# Step 4-2 保存マップ（Android の Google Maps 表示用・任意）。app.config.ts がビルド時に AndroidManifest へ入れる。
# サーバー用の GOOGLE_PLACES_API_KEY とは別のキーを作り、Google Cloud で
#   アプリ制限: Android アプリ（com.promeon.mikke + 署名証明書 SHA-1）/ API 制限: Maps SDK for Android のみ
# をかけること。未設定なら Android の地図は代替表示になる（iOS は Apple Maps でキー不要）。
# EAS Build では .env.local は使われないため、EAS の環境変数にも同じ名前で登録する。
GOOGLE_MAPS_ANDROID_API_KEY=

# Step 5-1 公開ページ（利用規約・プライバシーポリシー・お問い合わせ・アカウント削除案内）の Web URL（任意・公開値）。
# 未設定なら src/constants/public-pages.ts の既定値（https://mikke-frontend.vercel.app）を使う。
# 独自ドメインへ移行するときに設定する。EAS Build では EAS の環境変数にも同じ名前で登録する。
EXPO_PUBLIC_WEB_BASE_URL=https://mikke-frontend.vercel.app
