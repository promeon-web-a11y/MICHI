{
  "expo": {
    "name": "Mikke",
    "slug": "mikke-mobile",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mikke",
    "userInterfaceStyle": "light",
    "primaryColor": "#FF7A59",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.promeon.mikke",
      "supportsTablet": false
    },
    "android": {
      "package": "com.promeon.mikke",
      "adaptiveIcon": {
        "backgroundColor": "#FEFBF8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1C1815",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "お出かけの記録に載せる写真を選ぶために、写真ライブラリを使用します。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false,
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "現在地の周辺にある保存した場所を地図で確認したり、現在地からお出かけプランを作成したりするために位置情報を使用します。",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "extensionBundleIdentifier": "com.promeon.mikke.ShareExtension",
            "appGroupId": "group.com.promeon.mikke",
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsWebPageWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "expo-sharing-extension",
                  "bundleIdentifier": "com.promeon.mikke.ShareExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.promeon.mikke"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "e1f617ad-3973-412f-96ea-2ff2c026f9c1"
      }
    },
    "owner": "mikke.map"
  }
}
