# 本番Edge Function用のSecrets。
# SUPABASE_URL / SUPABASE_ANON_KEY はデプロイ後に自動注入されるため、ここには書きません
# （SUPABASE_ で始まる名前はSecretとして登録できません）。
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_PLAN_MODEL=replace_with_available_structured_output_model
GOOGLE_PLACES_API_KEY=replace_with_google_places_api_key
# 任意: identify-place 用に別モデルを使う場合のみ設定（未設定なら OPENAI_PLAN_MODEL を使用）
# OPENAI_IDENTIFY_MODEL=replace_with_available_structured_output_model
# route-plan（Step 4-6）用。サーバー専用・API 制限で Routes API のみ許可したキーを推奨。
# 未設定なら GOOGLE_PLACES_API_KEY を使う（そのキーで Routes API が許可されている場合のみ動作）。
# GOOGLE_ROUTES_API_KEY=replace_with_google_routes_api_key
